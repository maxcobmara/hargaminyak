.columns.home[class=(@stretched_mode ? "stretched-mode" : nil)]
  - @prices.each do |item|
    .column.col-12.col-lg-12.pbox class=item[:identifier]
      .title 
        = item[:title]
        small.subtitle = item[:description]
      .price-row
        .price
          span.rm RM
          = format(item[:values])
        .change
          = format_previous(item[:values])